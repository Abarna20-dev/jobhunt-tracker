# ==========================================
# JobHunt Tracker - Environment Variables
# ==========================================

# Required: Credentials for logging in to your dashboard
APP_LOGIN_EMAIL=user@example.com
APP_LOGIN_PASSWORD=your_secure_password
APP_LOGIN_NAME=Your Name

# Optional: Gmail assistant (for scanning job emails via IMAP)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Optional: Claude AI for deep email classification fallback
ANTHROPIC_API_KEY=your_anthropic_api_key

